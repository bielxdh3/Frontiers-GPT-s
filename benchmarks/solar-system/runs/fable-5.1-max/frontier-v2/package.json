{
  "name": "solar-system-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Observatório do Sistema Solar — interactive 3D solar system observatory for the browser",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.26.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
